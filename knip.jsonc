{
	// Unused files, exports, and dependencies. Run: bun run knip
	// Docs: https://knip.dev/reference/configuration
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"entry": [
		// Service worker, compiled by scripts/generate-sw.ts during build:prod
		"src/sw.ts",
		// resolve.alias targets in .storybook/main.ts and vitest configs, which knip can't trace
		"src/storybook/**/*.{ts,tsx}",
		"src/test/mocks/*.ts",
		"src/utils/query/__tests__/mocks/*.ts",
		".storybook/env.mock.ts",
		// Lingui CLI config and its compiled catalogs (no knip plugin for Lingui)
		"lingui.config.js",
		"src/locales/*/messages.js",
		// Vendored shadcn/Base UI component library: keep the full component API
		// even when a component or sub-component isn't used yet
		"src/components/ui/**/*.tsx",
		// Baseline: files that were already unused when knip was adopted. Wire each
		// one up or delete it, then remove it from this list. Don't add to it.
		".storybook/vite.config.ts",
		"src/emails/index.ts",
		"src/functions/helpers.ts",
		"src/lib/monitoring/index.ts",
		"src/lib/vite/server-guard{,-config}.ts",
		"src/server/db/types.ts",
		"src/utils/{env,index}.ts",
		"src/utils/query/helpers.ts"
	],
	"ignoreExportsUsedInFile": true,
	// Fail when an ignore/entry above goes stale, so fixed baseline entries get removed
	"treatConfigHintsAsErrors": true,
	"ignoreIssues": {
		// Mocks mirror the export shape (named + default) of the modules they replace
		"src/storybook/**": ["duplicates"],
		// Baseline, with the entry above: never wired up, and imports a package that isn't installed
		".storybook/vite.config.ts": ["unlisted"],
		// Baseline: exports that were already unused when knip was adopted. Delete
		// (or start using) them, then drop the file from this list. Don't add to it.
		"src/components/form/types.ts": ["types"],
		"src/emails/WelcomeEmail.tsx": ["duplicates"],
		"src/env.ts": ["exports"],
		"src/functions/base-service.ts": ["types"],
		"src/lib/env/release.ts": ["exports"],
		"src/lib/monitoring/types.ts": ["types"],
		"src/server/auth/auth.ts": ["types"],
		"src/server/db/DrizzleOrm.ts": ["exports", "types"],
		"src/server/lib/sse-channel.ts": ["exports"],
		"src/utils/auth-client.ts": ["types"],
		"src/utils/logger.ts": ["exports"],
		"src/utils/query/queries.ts": ["types"]
	},
	"ignoreDependencies": [
		// Baseline: dependencies that were already unused when knip was adopted.
		// Remove each one (or start using it), then drop it from this list.
		"@lingui/macro",
		"@tanstack/react-table",
		"react-email",
		"unenv",
		"@lingui/loader",
		"@serwist/window",
		"@storybook/addon-a11y",
		"@storybook/addon-coverage",
		"@storybook/addon-links",
		"@storybook/addon-themes",
		"@storybook/test-runner",
		"@types/dotenv",
		"autoprefixer",
		"globals"
	],
	// Globally installed developer tools used by package.json scripts
	"ignoreBinaries": ["fixpack"]
}
