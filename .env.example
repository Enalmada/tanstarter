# drizzle:migrate script looks for this
NODE_ENV=development

# Enable TanStack DevTools (Query & Router DevTools overlays)
# Set to "true" to enable DevTools in development
# DevTools are always disabled in production builds
PUBLIC_ENABLE_DEVTOOLS=false

# Application Environment
# Valid values: development, preview, staging, production
# Defaults to:
# - development in local
# - preview for PR deployments
# - staging for the dev branch
# - production for the main branch
APP_ENV=development

# PostgreSQL connection
DATABASE_URL="postgres://postgres:postgres@db.localtest.me:5434/tanstarter"

# OAuth2 Providers
# https://console.cloud.google.com/apis/credentials?authuser=1&project=<project>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# BetterAuth
BETTER_AUTH_SECRET=<random-secret-string>

# Becoming admin
# Locally (APP_ENV=development) the Profile page has a "Make Admin" toggle.
# On deployed apps, list emails that become ADMIN when their account is first
# created via Google sign-in (verified email). Comma-separated.
ADMIN_EMAILS=
# "true" turns the Profile toggle back on outside local dev (public demos only:
# every signed-in visitor can make themselves admin — use a throwaway database).
# DEMO_MODE=false

# App URL (for Better Auth, Rollbar, analytics, etc.)
PUBLIC_APP_URL="http://localhost:3000"

# Axiom
AXIOM_DATASET_NAME=
AXIOM_TOKEN=

# Rollbar Error Monitoring
# Client-side monitoring token (public)
PUBLIC_ROLLBAR_ACCESS_TOKEN=
# Server-side post_server_item token (private). When set at build time,
# `vite build` uploads hidden client source maps to Rollbar and deletes them
# from the output (scripts/vite-rollbar-sourcemaps.ts). The upload also needs
# PUBLIC_APP_URL and a release version at build time.
ROLLBAR_SERVER_TOKEN=
# Release version for the source map upload and the client's code_version
# (e.g. the git SHA, max 40 chars). Falls back to the FLY_IMAGE_REF tag.
# RELEASE_VERSION=

# Product Analytics
PUBLIC_POSTHOG_API_KEY=
