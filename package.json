{
	"name": "tanstarter",
	"version": "0.1.0",
	"scripts": {
		"build": "bun --bun vite build",
		"build-storybook": "storybook build",
		"build:prod": "bun run build && bun run drizzle:migrate",
		"check": "turbo lint check-types knip check-tss-2 check-tss-7 check-stories test:unit test-storybook test:e2e",
		"check:e2e-specs": "bun scripts/check-e2e-specs.ts",
		"check-stories": "bun scripts/check-component-coverage.cjs --quiet",
		"check-tss-2": "bash scripts/check-tss-2.sh",
		"check-tss-7": "bash scripts/check-tss-7.sh",
		"audit:deps": "sh scripts/audit-deps.sh",
		"check-types": "tsc --noEmit",
		"compile": "lingui compile",
		"db": "drizzle-kit",
		"deps": "taze -Ilw --maturity-period 3",
		"dev": "bun run docker:up && sh scripts/wait-for.sh && turbo dev:vite storybook --ui=tui",
		"dev:install": "bun install",
		"dev:vite": "vite dev --port 3000",
		"docker:up": "docker compose --env-file .env up -d --remove-orphans",
		"drizzle:data": "bun run drizzle:migrate && bun run drizzle:seed",
		"drizzle:generate": "dotenv -e ./.env drizzle-kit generate",
		"drizzle:migrate": "bun ./src/server/db/migrate.ts",
		"drizzle:reseed": "docker compose down -v && bun run docker:up -d && sh scripts/wait-for.sh && bun run drizzle:generate && bun run drizzle:migrate && bun run drizzle:seed",
		"drizzle:seed": "bun --env-file=.env ./src/server/db/seed.ts",
		"drizzle:studio": "bunx drizzle-kit studio",
		"extract": "lingui extract",
		"fix": "fixpack",
		"knip": "knip",
		"lint": "biome check --fix --unsafe",
		"prepare": "lefthook install",
		"scan:secrets": "bash scripts/scan-secrets.sh",
		"start": "bun run .output/server/index.mjs",
		"storybook": "storybook dev -p 6006 --no-open",
		"test-storybook": "vitest run --project storybook",
		"test-storybook:watch": "vitest --project storybook",
		"test:e2e": "playwright test",
		"test:e2e:admin": "playwright test --project=admin",
		"test:e2e:codegen": "playwright codegen http://localhost:3000",
		"test:e2e:debug": "playwright test --debug",
		"test:e2e:member": "playwright test --project=member",
		"test:e2e:report": "bunx playwright show-report playwright/report --host 127.0.0.1 --port 9323",
		"test:e2e:ui": "playwright test --ui",
		"test:unit": "cross-env NODE_ENV=test dotenv -o -e .env.test.local -e .env.test -- bunx vitest run --config vitest.unit.config.ts",
		"test:unit:coverage": "cross-env NODE_ENV=test dotenv -e .env.test.local -e .env.test -- vitest run --coverage --config vitest.unit.config.ts",
		"test:unit:watch": "cross-env NODE_ENV=test dotenv -o -e .env.test.local -e .env.test -- vitest watch --config vitest.unit.config.ts",
		"ui": "bunx shadcn@latest"
	},
	"dependencies": {
		"@axiomhq/js": "1.6.1",
		"@base-ui/react": "1.5.0",
		"@better-auth/drizzle-adapter": "1.7.6",
		"@casl/ability": "6.8.1",
		"@enalmada/start-secure": "1.0.2",
		"@enalmada/start-streaming": "2.0.0",
		"@lingui/core": "5.7.0",
		"@lingui/react": "5.7.0",
		"@neondatabase/serverless": "1.1.0",
		"@react-email/components": "1.0.12",
		"@react-email/render": "2.0.8",
		"@react-email/tailwind": "2.0.7",
		"@tanstack/react-form": "1.32.1",
		"@tanstack/react-query": "5.104.0",
		"@tanstack/react-router": "1.170.40",
		"@tanstack/react-router-ssr-query": "1.167.3",
		"@tanstack/react-start": "1.168.59",
		"@tanstack/start-storage-context": "1.167.35",
		"@unpic/react": "1.0.2",
		"better-auth": "1.7.6",
		"better-sse": "0.16.1",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"drizzle-orm": "1.0.0-rc.4",
		"drizzle-valibot": "0.4.2",
		"envin": "1.2.0",
		"lucide-react": "1.17.0",
		"nanoid": "5.1.11",
		"postgres": "3.4.9",
		"posthog-js": "1.434.14",
		"posthog-node": "5.54.1",
		"react": "19.2.6",
		"react-dom": "19.2.6",
		"react-error-boundary": "6.1.2",
		"sonner": "2.0.7",
		"tailwind-merge": "3.6.0",
		"tailwindcss-animate": "1.0.7",
		"valibot": "1.4.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.16",
		"@lingui/babel-plugin-lingui-macro": "5.7.0",
		"@lingui/cli": "5.7.0",
		"@lingui/loader": "5.7.0",
		"@lingui/macro": "5.7.0",
		"@lingui/vite-plugin": "5.7.0",
		"@playwright/test": "1.60.0",
		"@serwist/build": "9.5.11",
		"@serwist/vite": "9.5.12",
		"@storybook/addon-a11y": "10.4.1",
		"@storybook/addon-coverage": "3.0.1",
		"@storybook/addon-docs": "10.4.1",
		"@storybook/addon-links": "10.4.1",
		"@storybook/addon-themes": "10.4.1",
		"@storybook/addon-vitest": "10.4.1",
		"@storybook/react": "10.4.1",
		"@storybook/react-vite": "10.4.1",
		"@tailwindcss/postcss": "4.3.0",
		"@tailwindcss/vite": "4.3.0",
		"@tanstack/react-devtools": "0.10.5",
		"@tanstack/react-query-devtools": "5.104.0",
		"@tanstack/router-devtools": "1.167.2",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/react": "16.3.2",
		"@types/node": "24.13.6",
		"@types/react": "19.2.15",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "5.2.0",
		"@vitest/browser": "4.1.7",
		"@vitest/browser-playwright": "4.1.7",
		"@vitest/coverage-v8": "4.1.7",
		"babel-plugin-react-compiler": "1.0.0",
		"cross-env": "10.1.0",
		"date-fns": "4.3.0",
		"dotenv": "17.4.2",
		"dotenv-cli": "11.0.0",
		"drizzle-kit": "1.0.0-rc.4",
		"happy-dom": "20.9.0",
		"knip": "6.38.0",
		"lefthook": "2.1.8",
		"nitro": "3.0.260903-beta",
		"serwist": "9.5.11",
		"storybook": "10.4.1",
		"tailwindcss": "4.3.0",
		"taze": "21.1.0",
		"turbo": "2.9.16",
		"typescript": "7.0.2",
		"vite": "8.3.1",
		"vitest": "4.1.7"
	},
	"engines": {
		"node": ">=24"
	},
	"description": "production ready boilerplate for Tanstack Starter",
	"private": true,
	"main": "",
	"packageManager": "bun@1.4.2",
	"trustedDependencies": [
		"@biomejs/biome",
		"@parcel/watcher",
		"@swc/core",
		"@tailwindcss/oxide",
		"bufferutil",
		"core-js",
		"esbuild",
		"lefthook",
		"sharp"
	],
	"type": "module"
}
